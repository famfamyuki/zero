{
  "description": "AgentGraph read-only local start/resume context; requires Codex Hook trust.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/harness-hook.mjs\"",
            "commandWindows": "$agsRoot = git rev-parse --show-toplevel; if ($LASTEXITCODE -ne 0) { exit 1 }; node (Join-Path $agsRoot 'scripts/harness-hook.mjs')",
            "timeout": 10,
            "additionalContextLimit": 700,
            "statusMessage": "Checking local AgentGraph source state"
          }
        ]
      }
    ]
  }
}
